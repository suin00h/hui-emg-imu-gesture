    given-names: Suin
  - family-names: Jo
    given-names: Geonhui
  - family-names: Suh
    given-names: Sungho
keywords:
  - electromyography
  - inertial measurement unit
  - gesture recognition
  - cross-user generalization
  - one-shot learning
